# SQLite database file (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Optional: enables the real Claude-powered AI chatbot and recommendations.
# Get a key at https://console.anthropic.com — without it, the app falls back
# to built-in rule-based responses.
ANTHROPIC_API_KEY=""
