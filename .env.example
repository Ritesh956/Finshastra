# Neon Postgres connection string.
# Locally: use the DIRECT host (ep-xxx.region.aws.neon.tech) — prisma migrate
# doesn't work through the pooler. On Netlify/serverless: use the POOLED host
# (ep-xxx-pooler.region.aws.neon.tech). Keep sslmode=require; drop
# channel_binding=require if present.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Optional: enables the real Claude-powered AI chatbot and recommendations.
# Get a key at https://console.anthropic.com — without it, the app falls back
# to built-in rule-based responses.
ANTHROPIC_API_KEY=""

# Optional: Razorpay payment gateway (use test-mode keys from
# https://dashboard.razorpay.com). Without keys, EMI payments run through a
# built-in simulated checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional: SMTP settings for EMI reminder + password reset emails.
# Without them, emails are logged to the server console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="FinShastra <no-reply@finshastra.local>"

# Secret for triggering the EMI reminder job (POST /api/reminders/run)
CRON_SECRET=""
